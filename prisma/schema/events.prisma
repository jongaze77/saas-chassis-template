model Event {
  id            String    @default(cuid())
  accountId     String    @map("account_id")
  type          EventType
  actorId       String    @map("actor_id")
  actorType     ActorType @map("actor_type")
  targetType    String?   @map("target_type")
  targetId      String?   @map("target_id")
  payload       Json?
  parentEventId String?   @map("parent_event_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parentEvent Event?  @relation("EventChain", fields: [parentEventId, accountId], references: [id, accountId])
  childEvents Event[] @relation("EventChain")

  @@id([id, accountId])
  @@index([accountId, createdAt(sort: Desc)], name: "idx_events_account_id_created_at")
  @@map("events")
}

model AccountSummary {
  id        String   @id @default(cuid())
  accountId String   @unique @map("account_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Add your domain-specific summary fields here

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_summaries")
}
